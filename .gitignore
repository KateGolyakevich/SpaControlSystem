# ====================================================================
# CLion / JetBrains IDE
# ====================================================================
# Папки сборки CLion по умолчанию (Debug, Release, RelWithDebInfo и т.д.)
cmake-build-*/

# Системные настройки и кэш CLion
.idea/
*.iws
*.iml

# Временные файлы поиска и полок CLion
.shelf/

# ====================================================================
# CMake и процесс компиляции
# ====================================================================
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
CTestTestfile.cmake
build/
bin/
lib/
out/

# Объектные и промежуточные файлы компилятора
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exp
*.ilk
*.pdb

# Исполняемые файлы (бинарники)
*.exe
*.out
*.app

# ====================================================================
# Qt (Автоматически генерируемый код MOC, UIC, RCC)
# ====================================================================
# Файлы, которые Qt генерирует на лету (их не должно быть в репозитории)
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.qmlc
*.jsc
.qmake.stash
*.user*

# ====================================================================
# Статический анализатор SonarCloud
# ====================================================================
.sonar/
.scannerwork/

# ====================================================================
# Системный мусор ОС
# ====================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ====================================================================
# Файловая база данных (ПРИМЕЧАНИЕ):
# Текстовые файлы из папки data/ отслеживаются Git,
# чтобы у преподавателя сразу запустилась программа с начальными данными.
# ====================================================================
!data/*.txt